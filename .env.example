# Local development database only. Replace with the dedicated sahar_dev connection.
DATABASE_URL="mysql://sahar:change-me@127.0.0.1:3306/sahar_dev"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="placeholder-google-secret"

# Initial owner bootstrap (used only by prisma db seed)
OWNER_EMAIL="owner@sahar.ch"
OWNER_PASSWORD="replace-with-a-strong-password"
OWNER_NAME="Sahar Owner"

# AWS S3 placeholders
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="placeholder-access-key"
AWS_SECRET_ACCESS_KEY="placeholder-secret-key"
S3_BUCKET_NAME="sahar-placeholder"
S3_PUBLIC_BASE_URL="https://sahar-placeholder.s3.eu-central-1.amazonaws.com"

# Resend placeholders
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="Sahar <no-reply@sahar.ch>"

# Public app URL
APP_URL="http://localhost:3000"

# Stripe test mode only during Phase 3
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
